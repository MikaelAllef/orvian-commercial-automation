      "parameters": {
        "sendTo": "={{ $json['E-mail principal'] }}",
        "subject": "=Próximos Passos: Instagram Profissional da {{ $json['Nome da Empresa'] }}",
        "message": "=<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>ORVIAN — Próximos passos</title>\n</head>\n\n<body style=\"margin:0; padding:0; background-color:#f3f3f1; font-family:Arial, Helvetica, sans-serif; color:#171717;\">\n\n  <!-- CONTAINER PRINCIPAL -->\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#f3f3f1; margin:0; padding:30px 0;\">\n    <tr>\n      <td align=\"center\">\n\n        <!-- CARD -->\n        <table width=\"680\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width:680px; width:100%; background-color:#ffffff;\">\n\n          <!-- HEADER -->\n          <tr>\n            <td style=\"background-color:#111111; padding:38px 45px;\">\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n\n                  <td>\n                    <div style=\"font-size:30px; font-weight:bold; letter-spacing:5px; color:#ffffff;\">\n                      ORVI<span style=\"color:#c9a84c;\">A</span>N\n                    </div>\n\n                    <div style=\"margin-top:8px; font-size:10px; letter-spacing:4px; color:#c9a84c;\">\n                      MARCAS QUE GERAM RESULTADOS\n                    </div>\n                  </td>\n\n                  <td align=\"right\" valign=\"middle\">\n                    <div style=\"font-size:12px; color:#bdbdbd;\">\n                      INSTAGRAM\n                    </div>\n\n                    <div style=\"margin-top:5px; font-size:12px; color:#ffffff;\">\n                      Estratégia & Conteúdo\n                    </div>\n                  </td>\n\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n\n          <!-- DESTAQUE -->\n          <tr>\n            <td style=\"padding:48px 45px 30px 45px;\">\n\n              <div style=\"font-size:14px; color:#9b7a2e; font-weight:bold; letter-spacing:1px; margin-bottom:12px;\">\n                SEJA BEM-VINDO À ORVIAN\n              </div>\n\n              <h1 style=\"margin:0; font-size:32px; line-height:1.2; color:#111111;\">\n                Vamos fortalecer a presença da sua marca.\n              </h1>\n\n              <p style=\"margin:22px 0 0 0; font-size:16px; line-height:1.7; color:#555555;\">\n                Olá, <strong style=\"color:#111111;\">{{ $json[\"Nome Completo\"] }}</strong>!\n              </p>\n\n              <p style=\"margin:15px 0 0 0; font-size:16px; line-height:1.7; color:#555555;\">\n                Ficamos muito felizes em saber que você quer fortalecer a presença da\n                <strong style=\"color:#111111;\">{{ $json[\"Nome da Empresa\"] }}</strong>\n                no Instagram de forma profissional.\n              </p>\n\n              <p style=\"margin:15px 0 0 0; font-size:16px; line-height:1.7; color:#555555;\">\n                Na ORVIAN, cuidamos da gestão e produção de conteúdo para transformar\n                o Instagram em um canal estratégico para o seu negócio.\n              </p>\n\n            </td>\n          </tr>\n\n\n          <!-- DIVISOR -->\n          <tr>\n            <td style=\"padding:0 45px;\">\n              <div style=\"height:1px; background-color:#e5e5e5;\"></div>\n            </td>\n          </tr>\n\n\n          <!-- INTRODUÇÃO -->\n          <tr>\n            <td style=\"padding:35px 45px 20px 45px;\">\n\n              <h2 style=\"margin:0; font-size:22px; color:#111111;\">\n                Para começarmos\n              </h2>\n\n              <p style=\"margin:12px 0 0 0; font-size:15px; line-height:1.7; color:#666666;\">\n                Para entendermos melhor o seu negócio e construirmos uma estratégia\n                alinhada à sua realidade, precisamos de algumas informações.\n              </p>\n\n            </td>\n          </tr>\n\n\n          <!-- BLOCO DE INFORMAÇÕES -->\n          <tr>\n            <td style=\"padding:10px 45px 30px 45px;\">\n\n              <!-- ITEM 1 -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                <tr>\n                  <td width=\"48\" valign=\"top\">\n                    <div style=\"width:34px; height:34px; line-height:34px; text-align:center; background-color:#111111; color:#c9a84c; font-weight:bold; border-radius:50%;\">\n                      01\n                    </div>\n                  </td>\n\n                  <td valign=\"top\">\n                    <div style=\"font-size:15px; font-weight:bold; color:#111111;\">\n                      Ramo de atuação\n                    </div>\n\n                    <div style=\"margin-top:5px; font-size:14px; line-height:1.5; color:#666666;\">\n                      Quais são os principais produtos ou serviços da sua empresa?\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n\n              <!-- ITEM 2 -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                <tr>\n                  <td width=\"48\" valign=\"top\">\n                    <div style=\"width:34px; height:34px; line-height:34px; text-align:center; background-color:#111111; color:#c9a84c; font-weight:bold; border-radius:50%;\">\n                      02\n                    </div>\n                  </td>\n\n                  <td valign=\"top\">\n                    <div style=\"font-size:15px; font-weight:bold; color:#111111;\">\n                      Objetivo com o Instagram\n                    </div>\n\n                    <div style=\"margin-top:5px; font-size:14px; line-height:1.5; color:#666666;\">\n                      Você quer vender, engajar, divulgar sua marca, atrair clientes\n                      ou alcançar outro objetivo?\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n\n              <!-- ITEM 3 -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                <tr>\n                  <td width=\"48\" valign=\"top\">\n                    <div style=\"width:34px; height:34px; line-height:34px; text-align:center; background-color:#111111; color:#c9a84c; font-weight:bold; border-radius:50%;\">\n                      03\n                    </div>\n                  </td>\n\n                  <td valign=\"top\">\n                    <div style=\"font-size:15px; font-weight:bold; color:#111111;\">\n                      Referências\n                    </div>\n\n                    <div style=\"margin-top:5px; font-size:14px; line-height:1.5; color:#666666;\">\n                      Compartilhe perfis que você gosta ou considera alinhados\n                      à sua empresa.\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n\n              <!-- ITEM 4 -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom:12px;\">\n                <tr>\n                  <td width=\"48\" valign=\"top\">\n                    <div style=\"width:34px; height:34px; line-height:34px; text-align:center; background-color:#111111; color:#c9a84c; font-weight:bold; border-radius:50%;\">\n                      04\n                    </div>\n                  </td>\n\n                  <td valign=\"top\">\n                    <div style=\"font-size:15px; font-weight:bold; color:#111111;\">\n                      Materiais que já possui\n                    </div>\n\n                    <div style=\"margin-top:5px; font-size:14px; line-height:1.5; color:#666666;\">\n                      Logo, identidade visual, fotos, vídeos e outras informações\n                      da empresa.\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n\n              <!-- ITEM 5 -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n                  <td width=\"48\" valign=\"top\">\n                    <div style=\"width:34px; height:34px; line-height:34px; text-align:center; background-color:#111111; color:#c9a84c; font-weight:bold; border-radius:50%;\">\n                      05\n                    </div>\n                  </td>\n\n                  <td valign=\"top\">\n                    <div style=\"font-size:15px; font-weight:bold; color:#111111;\">\n                      Frequência de postagens\n                    </div>\n\n                    <div style=\"margin-top:5px; font-size:14px; line-height:1.5; color:#666666;\">\n                      Qual frequência de postagens você imagina ou espera?\n                    </div>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n\n          <!-- CTA -->\n          <tr>\n            <td style=\"padding:10px 45px 45px 45px;\">\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\"\n                     style=\"background-color:#f7f4ed; border-left:4px solid #c9a84c;\">\n\n                <tr>\n                  <td style=\"padding:22px 24px;\">\n\n                    <div style=\"font-size:16px; font-weight:bold; color:#111111;\">\n                      Próximo passo\n                    </div>\n\n                    <div style=\"margin-top:8px; font-size:14px; line-height:1.6; color:#666666;\">\n                      É só responder este e-mail compartilhando essas informações\n                      e referências. Se preferir, pode enviar tudo em um único arquivo.\n                    </div>\n\n                  </td>\n                </tr>\n\n              </table>\n\n\n              <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:25px;\">\n                <tr>\n                  <td align=\"center\" style=\"background-color:#c9a84c; border-radius:4px;\">\n\n                    <a href=\"mailto:contato@seu-dominio.com\"\n                       style=\"display:inline-block; padding:16px 28px; font-size:13px; font-weight:bold; letter-spacing:0.5px; color:#111111; text-decoration:none;\">\n                      RESPONDER ESTE E-MAIL &nbsp; →\n                    </a>\n\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n\n          <!-- ASSINATURA -->\n          <tr>\n            <td style=\"padding:0 45px 45px 45px;\">\n\n              <div style=\"font-size:14px; color:#777777;\">\n                Estamos à disposição para qualquer dúvida.\n              </div>\n\n              <div style=\"margin-top:28px; font-size:14px; color:#777777;\">\n                Abraços,\n              </div>\n\n              <div style=\"margin-top:5px; font-size:18px; font-weight:bold; color:#111111;\">\n                Equipe ORVIAN\n              </div>\n\n              <div style=\"margin-top:8px; font-size:10px; letter-spacing:3px; color:#c9a84c;\">\n                ESTRATÉGIA &nbsp; • &nbsp; CRIAÇÃO &nbsp; • &nbsp; RESULTADOS\n              </div>\n\n            </td>\n          </tr>\n\n\n          <!-- FOOTER -->\n          <tr>\n            <td style=\"background-color:#111111; padding:30px 45px;\">\n\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                <tr>\n\n                  <td>\n                    <div style=\"font-size:24px; font-weight:bold; letter-spacing:4px; color:#ffffff;\">\n                      ORVI<span style=\"color:#c9a84c;\">A</span>N\n                    </div>\n\n                    <div style=\"margin-top:7px; font-size:9px; letter-spacing:3px; color:#999999;\">\n                      MARCAS QUE GERAM RESULTADOS\n                    </div>\n                  </td>\n\n                  <td align=\"right\">\n                    <div style=\"font-size:13px; color:#c9a84c;\">\n                      Vamos construir\n                    </div>\n\n                    <div style=\"font-size:13px; color:#ffffff;\">\n                      o próximo nível da sua marca?\n                    </div>\n                  </td>\n\n                </tr>\n              </table>\n\n              <div style=\"height:1px; background-color:#333333; margin:25px 0 18px 0;\"></div>\n\n              <div style=\"font-size:11px; color:#777777; text-align:center;\">\n                ORVIAN • Estratégia, criação e soluções digitais\n              </div>\n\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
